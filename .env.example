# Azure Tenant / App Registration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_AUDIENCE=api://<backend-client-id>

# Azure AI Foundry
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_STANDARD=gpt-4.1-mini
AZURE_AI_MODEL_THINKING=o4-mini

# Foundry Agent Names (used by provision_agents.py and backend)
AZURE_AI_AGENT_INVOICE_NAME=meridian-invoice-agent
AZURE_AI_AGENT_INVENTORY_NAME=meridian-inventory-agent
AZURE_AI_AGENT_SALES_NAME=meridian-sales-agent
AZURE_AI_AGENT_ORCHESTRATOR_NAME=meridian-orchestrator-agent

# Fabric Connections (friendly name of Foundry project connections created in Foundry portal)
FABRIC_CONNECTION_INVOICE=meridian-fabric-invoice
FABRIC_CONNECTION_INVENTORY=meridian-fabric-inventory
FABRIC_CONNECTION_SALES=meridian-fabric-sales

# Fabric Data Agent GUIDs (from Fabric portal URL)
FABRIC_WORKSPACE_ID=<fabric-workspace-guid>
FABRIC_INVOICE_ARTIFACT_ID=<invoice-data-agent-artifact-guid>
FABRIC_INVENTORY_ARTIFACT_ID=<inventory-data-agent-artifact-guid>
FABRIC_SALES_ARTIFACT_ID=<sales-data-agent-artifact-guid>

# Backend settings
BACKEND_CORS_ORIGINS=http://localhost:5173,https://<your-app>.azurewebsites.net
LOG_LEVEL=INFO

# Frontend (.env in frontend/)
VITE_API_URL=http://localhost:8000
VITE_AZURE_CLIENT_ID=<spa-client-id>
VITE_AZURE_TENANT_ID=<tenant-id>
VITE_AZURE_BACKEND_SCOPE=api://<backend-client-id>/access_as_user
